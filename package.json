{
  "name": "g-academica",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión académica",
  "type": "module",
  "scripts": {
    "dev": "node --env-file .env $(which tsx) watch src/infrastructure/config/server.ts",
    "build": "tsc",
    "start": "node --env-file .env dist/src/infrastructure/config/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:smoke:local": "bash scripts/smoke-test-local.sh",
    "test:smoke:local:docker": "API_URL=http://localhost:3002 vitest run --config vitest.config.smoke.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:integration": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit smoke-test",
    "test:integration:e2e": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit e2e-test",
    "test:integration:db": "vitest run --config vitest.config.integration.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "dev:frontend": "npm run dev --prefix frontend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.19.0",
    "globals": "^17.6.0",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0"
  }
}
